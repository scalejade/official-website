# Copy to .env.local and fill in. Never commit real values.

# Supabase project URL and publishable (anon) key — public, shipped to the browser.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Supabase service-role (secret) key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
# Required for /portfolio (projects) and every /api write (posts, papers,
# projects, media). Dashboard -> Project Settings -> API Keys -> "secret".
SUPABASE_SERVICE_ROLE_KEY=

# Token that agents/integrations send to write through /api:
#   Authorization: Bearer <token>   or   x-api-key: <token>
# Use a long random value, e.g. `openssl rand -hex 32`.
BLOG_API_TOKEN=
